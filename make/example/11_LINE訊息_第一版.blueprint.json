{
 "name": "11 LINE 訊息（第一版）",
 "flow": [
  {
   "id": 1,
   "module": "line:watchMessages",
   "version": 1,
   "mapper": {},
   "metadata": {
    "designer": {
     "x": -300,
     "y": 0
    },
    "parameters": [
     {
      "name": "__IMTHOOK__",
      "type": "hook:line",
      "label": "Webhook",
      "required": true
     }
    ]
   },
   "parameters": {
    "__IMTHOOK__": 0
   }
  },
  {
   "id": 2,
   "module": "notion:searchObjects1",
   "version": 1,
   "mapper": {
    "limit": "1",
    "select": "data_source_item",
    "data_source": "<工作人員名冊 的 data source ID>",
    "filter": [
     [
      {
       "a": "LINE User ID |&*^%$#@| rich_text",
       "o": "text:equals",
       "b": "{{1.events[1].source.userId}}"
      }
     ]
    ]
   },
   "metadata": {
    "designer": {
     "x": 0,
     "y": 0,
     "name": "查身分：工作人員名冊"
    },
    "parameters": [
     {
      "name": "__IMTCONN__",
      "type": "account:notion2,notion3",
      "label": "Connection",
      "required": true
     }
    ]
   },
   "parameters": {
    "__IMTCONN__": 0
   }
  },
  {
   "id": 3,
   "module": "builtin:BasicRouter",
   "version": 1,
   "mapper": null,
   "metadata": {
    "designer": {
     "x": 300,
     "y": 0,
     "name": "依訊息分流"
    }
   },
   "routes": [
    {
     "flow": [
      {
       "id": 11,
       "module": "notion:searchObjects1",
       "version": 1,
       "mapper": {
        "limit": "1",
        "filter": [
         [
          {
           "a": "簽到代碼 |&*^%$#@| rich_text",
           "o": "text:equals",
           "b": "{{trim(replace(1.events[1].message.text; \"簽到\"; \"\"))}}"
          }
         ]
        ],
        "select": "data_source_item",
        "data_source": "<收容所開設 的 data source ID>"
       },
       "metadata": {
        "designer": {
         "x": 900,
         "y": 150,
         "name": "找簽到碼對應的開設"
        },
        "parameters": [
         {
          "name": "__IMTCONN__",
          "type": "account:notion2,notion3",
          "label": "Connection",
          "required": true
         }
        ]
       },
       "parameters": {
        "__IMTCONN__": 0
       },
       "filter": {
        "name": "R1 簽到",
        "conditions": [
         [
          {
           "a": "{{1.events[1].message.text}}",
           "o": "text:contain",
           "b": "SIGN-"
          }
         ]
        ]
       }
      },
      {
       "id": 20,
       "module": "builtin:BasicRouter",
       "version": 1,
       "mapper": null,
       "metadata": {
        "designer": {
         "x": 600,
         "y": 1500,
         "name": "簽到分流"
        }
       },
       "routes": [
        {
         "flow": [
          {
           "id": 12,
           "module": "notion:createDataSourceItem",
           "version": 1,
           "mapper": {
            "fields": [
             {
              "key": "紀錄",
              "type": "title",
              "value": "{{2.properties_value.`姓名`[].plain_text}} {{formatDate(now; \"MM/DD HH:mm\")}} 簽到"
             },
             {
              "key": "人員",
              "type": "relation",
              "value": [
               "{{2.id}}"
              ]
             },
             {
              "key": "收容所開設",
              "type": "relation",
              "value": [
               "{{11.id}}"
              ]
             },
             {
              "key": "簽到時間",
              "type": "date",
              "date": {
               "start": "{{now}}",
               "includeTime": true
              }
             },
             {
              "key": "簽到方式",
              "type": "select",
              "value": "掃現場 QR"
             }
            ],
            "select": "map",
            "data_source": "<出勤紀錄 的 data source ID>"
           },
           "metadata": {
            "designer": {
             "x": 900,
             "y": 300,
             "name": "新增出勤紀錄"
            },
            "parameters": [
             {
              "name": "__IMTCONN__",
              "type": "account:notion2,notion3",
              "label": "Connection",
              "required": true
             }
            ]
           },
           "parameters": {
            "__IMTCONN__": 0
           },
           "filter": {
            "name": "簽到成功",
            "conditions": [
             [
              {
               "a": "{{2.id}}",
               "o": "exist"
              },
              {
               "a": "{{2.properties_value.`啟用中`}}",
               "o": "boolean:equal",
               "b": "true"
              },
              {
               "a": "{{2.properties_value.`簽到狀態`.name}}",
               "o": "text:notequal",
               "b": "上班中"
              },
              {
               "a": "{{11.id}}",
               "o": "exist"
              },
              {
               "a": "{{11.properties_value.`開設狀態`.name}}",
               "o": "text:notequal",
               "b": "已撤收"
              }
             ]
            ]
           }
          },
          {
           "id": 13,
           "module": "notion:updateADatabaseItem",
           "version": 1,
           "mapper": {
            "page": "{{2.id}}",
            "fields": [
             {
              "key": "簽到狀態",
              "type": "select",
              "value": "上班中"
             },
             {
              "key": "派駐開設",
              "type": "relation",
              "value": [
               "{{11.id}}"
              ]
             },
             {
              "key": "選單狀態",
              "type": "select",
              "value": "{{if(2.properties_value.`身分類別`.name = \"工作人員\"; \"工作人員加乘\"; \"一般\")}}"
             },
             {
              "key": "對話暫存",
              "type": "rich_text",
              "value": "－"
             }
            ],
            "select": "map",
            "updateBy": "data_source",
            "data_source": "<工作人員名冊 的 data source ID>"
           },
           "metadata": {
            "designer": {
             "x": 900,
             "y": 450,
             "name": "名冊改上班中"
            },
            "parameters": [
             {
              "name": "__IMTCONN__",
              "type": "account:notion2,notion3",
              "label": "Connection",
              "required": true
             }
            ]
           },
           "parameters": {
            "__IMTCONN__": 0
           }
          },
          {
           "id": 14,
           "module": "line:sendAReplyMessage",
           "version": 1,
           "mapper": {
            "messages": [
             {
              "type": "text",
              "text": "✅ {{2.properties_value.`姓名`[].plain_text}} 已在【{{11.properties_value.`開設名稱`[].plain_text}}】簽到。\n開設狀態：{{11.properties_value.`開設狀態`.name}}\n{{if(2.properties_value.`身分類別`.name = \"工作人員\"; \"下方選單已換成工作人員版：掃描、本所、簽退。\"; \"請用 LINE 的 QR 掃描器掃物資標籤或號碼牌登記；要簽退請按選單的「工作人員」。\")}}"
             }
            ],
            "replyToken": "{{1.events[1].replyToken}}",
            "notificationDisabled": false
           },
           "metadata": {
            "designer": {
             "x": 900,
             "y": 600,
             "name": "回覆簽到成功"
            },
            "parameters": [
             {
              "name": "__IMTCONN__",
              "type": "account:line2",
              "label": "Connection",
              "required": true
             }
            ]
           },
           "parameters": {
            "__IMTCONN__": 0
           }
          },
          {
           "id": 15,
           "module": "line:makeApiCall",
           "version": 1,
           "mapper": {
            "url": "/v2/bot/richmenu/alias/staff-plus",
            "method": "GET",
            "headers": []
           },
           "metadata": {
            "designer": {
             "x": 900,
             "y": 750,
             "name": "取得加乘選單 ID"
            },
            "parameters": [
             {
              "name": "__IMTCONN__",
              "type": "account:line2",
              "label": "Connection",
              "required": true
             }
            ]
           },
           "parameters": {
            "__IMTCONN__": 0
           },
           "filter": {
            "name": "工作人員才換選單",
            "conditions": [
             [
              {
               "a": "{{2.properties_value.`身分類別`.name}}",
               "o": "text:equal",
               "b": "工作人員"
              }
             ]
            ]
           }
          },
          {
           "id": 21,
           "module": "line:makeApiCall",
           "version": 1,
           "mapper": {
            "url": "/v2/bot/user/{{1.events[1].source.userId}}/richmenu/{{15.body.richMenuId}}",
            "method": "POST",
            "headers": []
           },
           "metadata": {
            "designer": {
             "x": 900,
             "y": 1650,
             "name": "切換成加乘選單"
            },
            "parameters": [
             {
              "name": "__IMTCONN__",
              "type": "account:line2",
              "label": "Connection",
              "required": true
             }
            ]
           },
           "parameters": {
            "__IMTCONN__": 0
           }
          }
         ]
        },
        {
         "flow": [
          {
           "id": 16,
           "module": "line:sendAReplyMessage",
           "version": 1,
           "mapper": {
            "messages": [
             {
              "type": "text",
              "text": "{{2.properties_value.`姓名`[].plain_text}} 您目前已在班中。\n{{if(2.properties_value.`身分類別`.name = \"工作人員\"; \"下方選單已換成工作人員版：掃描、本所、簽退。\"; \"請用 LINE 的 QR 掃描器掃物資標籤或號碼牌登記；要簽退請按選單的「工作人員」。\")}}"
             }
            ],
            "replyToken": "{{1.events[1].replyToken}}",
            "notificationDisabled": false
           },
           "metadata": {
            "designer": {
             "x": 900,
             "y": 900,
             "name": "回覆已在班"
            },
            "parameters": [
             {
              "name": "__IMTCONN__",
              "type": "account:line2",
              "label": "Connection",
              "required": true
             }
            ]
           },
           "parameters": {
            "__IMTCONN__": 0
           },
           "filter": {
            "name": "已在班",
            "conditions": [
             [
              {
               "a": "{{2.id}}",
               "o": "exist"
              },
              {
               "a": "{{2.properties_value.`啟用中`}}",
               "o": "boolean:equal",
               "b": "true"
              },
              {
               "a": "{{2.properties_value.`簽到狀態`.name}}",
               "o": "text:equal",
               "b": "上班中"
              },
              {
               "a": "{{11.id}}",
               "o": "exist"
              }
             ]
            ]
           }
          },
          {
           "id": 17,
           "module": "line:makeApiCall",
           "version": 1,
           "mapper": {
            "url": "/v2/bot/richmenu/alias/staff-plus",
            "method": "GET",
            "headers": []
           },
           "metadata": {
            "designer": {
             "x": 900,
             "y": 1050,
             "name": "取得加乘選單 ID（已在班）"
            },
            "parameters": [
             {
              "name": "__IMTCONN__",
              "type": "account:line2",
              "label": "Connection",
              "required": true
             }
            ]
           },
           "parameters": {
            "__IMTCONN__": 0
           },
           "filter": {
            "name": "工作人員才換選單（已在班）",
            "conditions": [
             [
              {
               "a": "{{2.properties_value.`身分類別`.name}}",
               "o": "text:equal",
               "b": "工作人員"
              }
             ]
            ]
           }
          },
          {
           "id": 22,
           "module": "line:makeApiCall",
           "version": 1,
           "mapper": {
            "url": "/v2/bot/user/{{1.events[1].source.userId}}/richmenu/{{17.body.richMenuId}}",
            "method": "POST",
            "headers": []
           },
           "metadata": {
            "designer": {
             "x": 900,
             "y": 1800,
             "name": "切換成加乘選單（已在班）"
            },
            "parameters": [
             {
              "name": "__IMTCONN__",
              "type": "account:line2",
              "label": "Connection",
              "required": true
             }
            ]
           },
           "parameters": {
            "__IMTCONN__": 0
           }
          }
         ]
        },
        {
         "flow": [
          {
           "id": 18,
           "module": "line:sendAReplyMessage",
           "version": 1,
           "mapper": {
            "messages": [
             {
              "type": "text",
              "text": "⚠ 此簽到碼無效，或該收容所已撤收。請洽現場負責人。"
             }
            ],
            "replyToken": "{{1.events[1].replyToken}}",
            "notificationDisabled": false
           },
           "metadata": {
            "designer": {
             "x": 900,
             "y": 1200,
             "name": "回覆簽到碼無效"
            },
            "parameters": [
             {
              "name": "__IMTCONN__",
              "type": "account:line2",
              "label": "Connection",
              "required": true
             }
            ]
           },
           "parameters": {
            "__IMTCONN__": 0
           },
           "filter": {
            "name": "簽到碼無效",
            "conditions": [
             [
              {
               "a": "{{2.id}}",
               "o": "exist"
              },
              {
               "a": "{{2.properties_value.`啟用中`}}",
               "o": "boolean:equal",
               "b": "true"
              },
              {
               "a": "{{11.id}}",
               "o": "notexist"
              }
             ],
             [
              {
               "a": "{{2.id}}",
               "o": "exist"
              },
              {
               "a": "{{2.properties_value.`啟用中`}}",
               "o": "boolean:equal",
               "b": "true"
              },
              {
               "a": "{{2.properties_value.`簽到狀態`.name}}",
               "o": "text:notequal",
               "b": "上班中"
              },
              {
               "a": "{{11.properties_value.`開設狀態`.name}}",
               "o": "text:equal",
               "b": "已撤收"
              }
             ]
            ]
           }
          }
         ]
        },
        {
         "flow": [
          {
           "id": 19,
           "module": "line:sendAReplyMessage",
           "version": 1,
           "mapper": {
            "messages": [
             {
              "type": "text",
              "text": "您還不是已開通的工作人員。請按選單最下列的「工作人員」申請開通，由管理者審核後才能簽到。"
             }
            ],
            "replyToken": "{{1.events[1].replyToken}}",
            "notificationDisabled": false
           },
           "metadata": {
            "designer": {
             "x": 900,
             "y": 1350,
             "name": "回覆請先開通"
            },
            "parameters": [
             {
              "name": "__IMTCONN__",
              "type": "account:line2",
              "label": "Connection",
              "required": true
             }
            ]
           },
           "parameters": {
            "__IMTCONN__": 0
           },
           "filter": {
            "name": "不是工作人員",
            "conditions": [
             [
              {
               "a": "{{2.id}}",
               "o": "notexist"
              }
             ],
             [
              {
               "a": "{{2.properties_value.`啟用中`}}",
               "o": "boolean:notequal",
               "b": "true"
              }
             ]
            ]
           }
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "flow": [
      {
       "id": 23,
       "module": "line:sendAReplyMessage",
       "version": 1,
       "mapper": {
        "messages": [
         {
          "type": "text",
          "text": "您好，這裡是苗栗避難收容所系統。\n請點下方選單：收容所資訊、我要反映、緊急聯絡。\n工作人員請按最下列的「工作人員」。"
         }
        ],
        "replyToken": "{{1.events[1].replyToken}}",
        "notificationDisabled": false
       },
       "metadata": {
        "designer": {
         "x": 900,
         "y": 1950,
         "name": "回覆引導"
        },
        "parameters": [
         {
          "name": "__IMTCONN__",
          "type": "account:line2",
          "label": "Connection",
          "required": true
         }
        ]
       },
       "parameters": {
        "__IMTCONN__": 0
       },
       "filter": {
        "name": "R99 其他訊息",
        "conditions": [
         [
          {
           "a": "{{1.events[1].message.text}}",
           "o": "text:notcontain",
           "b": "SIGN-"
          }
         ]
        ]
       }
      }
     ]
    }
   ]
  }
 ],
 "metadata": {
  "instant": true,
  "version": 1,
  "designer": {
   "orphans": []
  },
  "scenario": {
   "dlq": true,
   "slots": null,
   "dataloss": false,
   "maxErrors": 3,
   "autoCommit": true,
   "roundtrips": 1,
   "sequential": false,
   "confidential": false,
   "freshVariables": false,
   "autoCommitTriggerLast": true
  }
 }
}